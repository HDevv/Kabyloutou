,{"children":"Pour éviter les dégâts des sols"}],["$","li",null,{"children":"Pour éviter la casse de canalisation à cause du tassement du sol"}]]}],["$","h2",null,{"children":"À quoi sert la plaque ou semelle vibrante ?"}],["$","p",null,{"children":"La plaque vibrante intervient dans plusieurs étapes de la construction :"}],["$","ul",null,{"children":[["$","li",null,{"children":"Lors de la fondation, elle permettra de damer le fond des fouilles"}],["$","li",null,{"children":"Sur des allées gravillonnées, elle est nécessaire pour stabiliser les couches de remblais"}],["$","li",null,{"children":"Sur les voies asphaltées, on l'utilise pour le compactage"}],["$","li",null,{"children":"Sur les pavages naturels et autobloquants, elle servira pour damer et égaliser"}],["$","li",null,{"children":"Sur la terre, elle permettra de maintenir une fermeté. Beaucoup de jardiniers l'utilise pour tasser le sable afin d'y poser un geotextile pour faire un gazon synthétique."}]]}],["$","h2",null,{"children":"CONSEILS"}],["$","p",null,{"children":"Il est nécessaire que vous vous munissiez de quelques dispositifs de sécurité, tels que:"}],["$","ul",null,{"children":[["$","li",null,{"children":"un casque de chantier"}],["$","li",null,{"children":"un masque anti-poussière"}],["$","li",null,{"children":"un casque de protection auditive"}],["$","li",null,{"children":"des lunettes de protection"}],["$","li",null,{"children":"des gants"}]]}]]}]]}]]}]],null],null]},["$","$L4",null,{"parallelRouterKey":"children","segmentPath":["children","conseil","children","dameuse-compactage","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L5",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined","styles":null}],null]},["$","$L4",null,{"parallelRouterKey":"children","segmentPath":["children","conseil","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$unde